{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrono-metrics/metricchrono/schemas/ladder.schema.json",
  "title": "MetricChrono Ladder",
  "type": "object",
  "additionalProperties": false,
  "required": ["metricchrono_schema", "tiers"],
  "properties": {
    "metricchrono_schema": { "const": "ladder.v1" },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epsilon", "delta", "p", "epsilon_ref"],
        "properties": {
          "epsilon": { "type": "number", "exclusiveMinimum": 0 },
          "delta": { "type": "number", "exclusiveMinimum": 0 },
          "p": { "type": "number" },
          "epsilon_ref": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
